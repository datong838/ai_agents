{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos.local/schemas/memory/authority.schema.json",
  "title": "AOS Memory Authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "project_revision",
    "authority_owner",
    "current_phase",
    "delivery_status",
    "last_green_gate",
    "next_gate",
    "source_commits",
    "source_files",
    "hard_boundaries",
    "completed",
    "incomplete",
    "next_steps",
    "evidence",
    "evidence_cutoff",
    "updated_at"
  ],
  "properties": {
    "schema": {"const": "aos-memory-authority/v1"},
    "project": {"type": "string", "minLength": 1},
    "project_revision": {"type": "string", "pattern": "^AOS-[0-9]{6}$"},
    "authority_owner": {"type": "string", "minLength": 1},
    "current_phase": {"type": "string", "minLength": 1},
    "delivery_status": {"type": "string", "minLength": 1},
    "last_green_gate": {"type": "string", "minLength": 1},
    "next_gate": {"type": "string", "minLength": 1},
    "source_commits": {"type": "object", "additionalProperties": {"type": "string"}},
    "source_files": {"type": "array", "items": {"type": "string"}},
    "hard_boundaries": {"type": "array", "items": {"type": "string"}},
    "completed": {"type": "array", "items": {"type": "string"}},
    "incomplete": {"type": "array", "items": {"type": "string"}},
    "next_steps": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "evidence_cutoff": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
