{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos.local/schemas/memory/leases.schema.json",
  "title": "AOS Memory Active Leases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "leases"],
  "properties": {
    "schema": {"const": "aos-memory-leases/v1"},
    "leases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "task_id",
          "owner",
          "base_revision",
          "scope",
          "excluded_scope",
          "expected_outputs",
          "lease_expires_at",
          "status",
          "created_at"
        ],
        "properties": {
          "schema": {"const": "aos-memory-task-receipt/v1"},
          "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "owner": {"type": "string", "minLength": 1},
          "base_revision": {"type": "string", "pattern": "^AOS-[0-9]{6}$"},
          "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "excluded_scope": {"type": "array", "items": {"type": "string"}},
          "expected_outputs": {"type": "array", "items": {"type": "string"}},
          "lease_expires_at": {"type": "string", "format": "date-time"},
          "status": {"const": "ACTIVE"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
